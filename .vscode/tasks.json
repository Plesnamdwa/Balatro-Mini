{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Balatro Mini Game",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Iinclude",
        "src/main.cpp",
        "-Llib",
        "-lglfw3",
        "-lopengl32",
        "-lgdi32",
        "-o",
        "balatro_mini.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
